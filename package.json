{
  "name": "cypherkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "vite site",
    "dev:site": "vite site",
    "build:site": "vite build site",
    "preview:site": "vite preview site",
    "db:generate": "bunx drizzle-kit generate --config=server/drizzle.config.ts",
    "db:generate:sqlite": "DATABASE_URL=sqlite://./cypherkey.db bun run db:generate",
    "db:generate:postgres": "DATABASE_URL=postgres://localhost/cypherkey bun run db:generate",
    "db:migrate": "bun server/src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.0.9",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^17.1.9",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
