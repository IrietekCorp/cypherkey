{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["@types/bun"],
    "jsx": "react-jsx"
  },
  "include": ["core/**/*", "server/**/*", "site/**/*", "scripts/**/*", "extension/**/*", "*.ts"]
}
